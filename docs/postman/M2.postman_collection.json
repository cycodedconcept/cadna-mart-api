{
  "info": {
    "name": "CADNA Mart \u2014 M2 catalogue",
    "description": "Public read-only requests. Start the API and apply migrations first. No authentication needed. Product detail requires a published product in an active category. No credentials are included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "00000000-0000-4000-8000-000000000000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health \u2014 database connection",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Database connected\", function () { pm.expect(pm.response.json().database).to.eql(\"connected\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/categories",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Products \u2014 save first product ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products",
        "description": "Saves the first product UUID for the detail request. If empty, the detail request returns 404 until you add published products in an active category."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(200); });",
              "const items = pm.response.json().data.items;",
              "pm.collectionVariables.set(\"productId\", items.length ? items[0].id : \"00000000-0000-4000-8000-000000000000\");"
            ]
          }
        }
      ]
    },
    {
      "name": "Products \u2014 search, price, stock and sorting",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products?q=laptop&min=10000&max=50000000&available=1&sort=price-asc&page=1",
        "description": "Price bounds are kobo: 10000 = NGN 100. An empty list is valid if no products match."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Product detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products/{{productId}}",
        "description": "Run Products first or set productId to an existing published product UUID. Requires catalogue data; otherwise expect 404."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Home",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/home",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid price range \u2014 expect 400",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products?min=200&max=100",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid product UUID \u2014 expect 400",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products/not-a-uuid",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing product \u2014 expect 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/products/00000000-0000-4000-8000-000000000000",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    }
  ]
}
